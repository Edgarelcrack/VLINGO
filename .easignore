# Este archivo controla QUÉ SE SUBE a los servidores de EAS.
# Cuando existe, EAS lo usa EN LUGAR de .gitignore.
# Es una copia de .gitignore, pero SIN excluir .env: react-native-dotenv
# necesita ese archivo durante el build (babel.config.js, allowUndefined: false).

# Dependencias
node_modules/

# Expo
.expo/
.expo-shared/

# React Native / Metro
.metro-cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
web-build/

# Android
android/.gradle/
android/.cxx/
android/app/build/
android/build/

# iOS
ios/Pods/
ios/build/
*.xcworkspace
*.xcuserdata
*.xcuserstate

# Certificados / perfiles (EAS gestiona los suyos)
*.p8
*.p12
*.mobileprovision

# TypeScript
*.tsbuildinfo

# Coverage
coverage/

# Temporales
*.tmp
*.temp

# Git
.git/
